import json

def get_all_errors_info(file_path):
    with open(file_path, 'r', encoding='utf-8') as f:
        data = json.load(f)

    error_counts = {}

    for session in data:
        detailed_errors = session.get("detailedErrors", {})
        for exercise, errors in detailed_errors.items():
            for error_name, count in errors.items():
                if count > 0:
                    if error_name not in error_counts:
                        error_counts[error_name] = 0
                    error_counts[error_name] += count

    sorted_errors = sorted(error_counts.items(), key=lambda x: x[1], reverse=True)
    return sorted_errors

